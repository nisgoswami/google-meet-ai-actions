{
  "manifest_version": 3,
  "name": "Threadport",
  "version": "1.2.1",
  "description": "Create and update Linear issues from Google Meet\u2019s Gemini messages. Local text transfer, no extra AI or transcript service.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.linear.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "core.js",
        "prompts.js",
        "vendor/turndown.js",
        "markdown.js",
        "adapters/google-meet.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Threadport settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html"
}
